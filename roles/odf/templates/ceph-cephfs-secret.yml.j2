{#
  CSI credentials for the CephFS driver.

  ocs-operator creates these same two Secrets from the external-cluster
  JSON, but without a type -- i.e. Opaque. A Secret's type is immutable, so
  these must be applied BEFORE the connection secret, otherwise on an
  already-reconciled cluster the apply fails with "field is immutable".

  ceph-csi reads userID/userKey; adminID/adminKey is a deprecated fallback.
#}
apiVersion: v1
kind: Secret
metadata:
  name: rook-csi-cephfs-provisioner
  namespace: {{ odf_namespace }}
type: kubernetes.io/rook
data:
  userID: {{ odf_cephfs_provisioner_client | regex_replace('^client\.', '') | b64encode }}
  userKey: {{ odf_cephfs_provisioner_key | b64encode }}
---
apiVersion: v1
kind: Secret
metadata:
  name: rook-csi-cephfs-node
  namespace: {{ odf_namespace }}
type: kubernetes.io/rook
data:
  userID: {{ odf_cephfs_node_client | regex_replace('^client\.', '') | b64encode }}
  userKey: {{ odf_cephfs_node_key | b64encode }}
